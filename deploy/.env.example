# 复制为 deploy/.env 后填写；不要提交真实密码。
# 在线使用公开 GHCR 镜像；离线导入 TAR 后改为 labos:0.2.0-rc.3。
LABOS_IMAGE=ghcr.io/hotll233/labmg:0.2.0-rc.3
LABOS_PORT=3000
LABOS_ADMIN_USER=admin
# 必填：设置自己的初始管理员密码，仅在空数据库首次启动时生效。
LABOS_ADMIN_PASSWORD=

# 相对路径以 deploy/ 为基准；群晖可改为 /volume1/docker/labos/0.2.0-rc.3。
LABOS_DATA_DIR=../var/docker/0.2.0-rc.3
# 数据目录必须预先允许此 UID/GID 写入。
LABOS_UID=1000
LABOS_GID=1000
