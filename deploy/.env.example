# LabOS 0.5.1：期初单据、位置与标签打印。
# 按需复制为 deploy/.env；管理员密码在首次打开网页时设置。
# 在线使用同版本 GHCR 镜像；离线导入并核对 TAR 后改为 labos:0.5.1。
LABOS_IMAGE=ghcr.io/hotll233/labmg:0.5.1
LABOS_PORT=3000
LABOS_ADMIN_USER=admin
# 默认自动创建 YML 同目录的 runtime/，集中保存数据库、附件和运行数据；升级不要改此目录。
# 已有部署优先保留原 YML/挂载和 UID-GID，仅更新 LABOS_IMAGE，不用此示例覆盖原配置。
# 换用此模板前，将旧数据完整迁入 runtime/，或保留原宿主机目录的绝对路径；不会自动迁移旧卷。
# LABOS_DATA_DIR=./runtime
# 首次启动由一次性初始化容器设置目录属主，应用始终以此非 root UID/GID 运行。
LABOS_UID=1000
LABOS_GID=1000

# 可选：可信 HTTPS 扫码代理。与 docker-compose.https.yml 和 Caddyfile 一起使用。
# 只填群晖局域网 IP 或主机名，不含协议和端口；需在手机安装并信任本地 CA。
# LABOS_HTTPS_HOST=192.168.1.10
# LABOS_HTTPS_PORT=8443
