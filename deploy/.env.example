# 按需复制为 deploy/.env；管理员密码在首次打开网页时设置。
# 在线使用公开 GHCR 镜像；离线导入 TAR 后改为 labos:0.2.0-rc.4。
LABOS_IMAGE=ghcr.io/hotll233/labmg:0.2.0-rc.4
LABOS_PORT=3000
LABOS_ADMIN_USER=admin
# 相对路径以 deploy/ 为基准；群晖可改为 /volume1/docker/labos/runtime/0.2.0-rc.4。
LABOS_DATA_DIR=../var/docker/0.2.0-rc.4
# 数据目录必须预先允许此 UID/GID 写入。
LABOS_UID=1000
LABOS_GID=1000
