# 按需复制为 deploy/.env；管理员密码在首次打开网页时设置。
# 在线使用公开 GHCR 镜像；离线导入 TAR 后改为 labos:0.3.0。
LABOS_IMAGE=ghcr.io/hotll233/labmg:0.3.0
LABOS_PORT=3000
LABOS_ADMIN_USER=admin
# 默认不设置 LABOS_DATA_DIR，由 Docker 自动创建本版命名数据卷和目录。
# 复用已有数据时才取消下一行注释，填真实、已存在的宿主机目录；不会自动迁移旧数据。
# LABOS_DATA_DIR=/volume1/docker/labos/runtime/0.3.0
# 首次启动由一次性初始化容器设置目录属主，应用始终以此非 root UID/GID 运行。
LABOS_UID=1000
LABOS_GID=1000
